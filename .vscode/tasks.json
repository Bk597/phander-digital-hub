{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Website (frontend :8080)",
      "type": "shell",
      "command": "php -S 127.0.0.1:8080 -t frontend",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "web",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "API backend (Laravel :8000)",
      "type": "shell",
      "command": "php artisan serve --host=0.0.0.0 --port=8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "web",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run website (frontend + backend)",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Website (frontend :8080)",
        "API backend (Laravel :8000)"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
